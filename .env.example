# ==========================================
# ARQUIVO DE EXEMPLO PARA VARIÁVEIS DE AMBIENTE
# ==========================================
# ATENÇÃO: Preencha com sua própria chave na sua máquina e renomeie 
# este arquivo para '.env', apenas. 

# Chave secreta usada para assinar os tokens JWT da aplicação
SECRET_KEY=sua_chave_secreta_aqui

# Algoritmo de criptografia utilizado na geração dos tokens
ALGORITHM=HS256